# Local preview: npm run dev. Never put secrets in src/config.mjs or public/.
PORT=4173
# Set the production origin when behind an HTTPS reverse proxy.
PUBLIC_ORIGIN=
# Independent account storage; keep outside dist/ and back it up.
ACCOUNT_DATA_FILE=data/accounts.json
# Optional request notification provider: webhook. Empty keeps deliveries disabled.
REQUEST_PROVIDER=
# Webhook must return HTTP 2xx AND {"ok":true}, {"success":true}, or {"status":"success"}.
REQUEST_WEBHOOK_URL=
REQUEST_WEBHOOK_TOKEN=
